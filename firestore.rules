rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Patient appointment data.
    // Clients can create appointments but cannot read, update,
    // or delete appointment records.
    match /appointments/{appointmentId} {

      allow read: if false;

      allow update, delete: if false;

      allow create: if
        request.resource.data.keys().hasOnly([
          'name',
          'phone',
          'email',
          'doctor',
          'date',
          'time',
          'service',
          'message',
          'createdAt'
        ])

        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200

        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() < 30

        && request.resource.data.email is string
        && request.resource.data.email.size() < 255

        && request.resource.data.doctor is string

        && request.resource.data.date is string

        && request.resource.data.time is string

        // "service" is a reserved keyword, so use bracket notation.
        && request.resource.data['service'] is string
        && request.resource.data['service'].size() < 200

        && request.resource.data.message is string
        && request.resource.data.message.size() < 1000

        && request.resource.data.createdAt == request.time;
    }


    // Publicly readable booked slots.
    // Clients can create a slot but cannot modify or delete it.
    //
    // If two patients attempt to create the same slot,
    // Firestore will reject the second create because the document
    // already exists.
    match /slots/{date}/doctors/{doctorKey}/booked/{time} {

      allow read: if true;

      allow update, delete: if false;

      allow create: if
        request.resource.data.keys().hasOnly([
          'bookedAt'
        ])

        && request.resource.data.bookedAt == request.time;
    }

    // Staff can free up a slot (appointment cancellation/reschedule).
    match /slots/{date}/doctors/{doctorKey}/booked/{time} {
       allow delete: if request.auth != null;
    }

    match /reviewsSync/{document} {
       allow read: if true;
       allow write: if false;
    }

    match /appointments/{doc} {
       allow create: if true;
       allow read, update, delete: if request.auth != null;
    }
    match /doctorAvailability/{doctorSlug} {
       allow read: if true;
       allow write: if request.auth != null;
    }

    // Offers and campaigns shown on the homepage. Staff add/delete them from /admin.
    // Both collections share one shape; see src/lib/promotions.ts.
    function validPromotion() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'title', 'images', 'startDate', 'endDate', 'startTime', 'endTime',
          'originalPrice', 'offerPrice', 'description', 'couponCode',
          'websiteUrl', 'terms', 'createdAt'
        ])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.images is list && d.images.size() >= 1 && d.images.size() <= 5
        && d.startDate is string && d.startDate.size() == 10
        && d.endDate is string && d.endDate.size() == 10
        && d.get('startTime', '00:00') is string
        && d.get('endTime', '00:00') is string
        && d.get('originalPrice', 0) is number
        && d.get('offerPrice', 0) is number
        && d.get('description', '') is string && d.get('description', '').size() <= 1000
        && d.get('couponCode', '') is string && d.get('couponCode', '').size() <= 40
        && d.get('websiteUrl', '') is string && d.get('websiteUrl', '').size() <= 500
        && d.get('terms', '') is string && d.get('terms', '').size() <= 5000
        && d.createdAt == request.time;
    }

    match /offers/{offerId} {
       allow read: if true;
       allow update: if false;
       allow delete: if request.auth != null;
       allow create: if request.auth != null && validPromotion();
    }

    match /campaigns/{campaignId} {
       allow read: if true;
       allow update: if false;
       allow delete: if request.auth != null;
       allow create: if request.auth != null && validPromotion();
    }

    match /appointmentEmails/{doc} {
       allow create: if true;
       allow read, delete: if request.auth != null;
    }
  }
}
